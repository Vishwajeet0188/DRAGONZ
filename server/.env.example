# ─────────────────────────────────────────────────────────────
# Dragonz Central — server environment
# Copy to .env and fill in. NEVER commit .env.
# ─────────────────────────────────────────────────────────────

# development | test | production
NODE_ENV=development
# Port the API listens on
PORT=4000
# Public URL of the web app (used in email links and CORS/Origin checks)
APP_URL=http://localhost:5173
# Comma-separated extra allowed origins for CORS (optional)
CORS_ORIGINS=
# Number of trusted reverse proxies in front of the API (1 behind Cloudflare/NGINX, 0 locally)
TRUST_PROXY=0

# PostgreSQL connection string
DATABASE_URL=postgresql://dragonz:change_me@localhost:5432/dragonz_central?schema=public

# 32+ random chars. Used to derive HMAC keys (unsubscribe links, etc).
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=replace_with_long_random_string
# Session lifetime in days (sliding)
SESSION_TTL_DAYS=30

# Log level: fatal | error | warn | info | debug
LOG_LEVEL=info

# Max DB connections from this server (5 is plenty on free Postgres tiers)
DB_POOL_MAX=10

# ── Email ──
# console (dev: prints emails to the terminal) | smtp (e.g. Brevo free SMTP) | resend
EMAIL_PROVIDER=console
EMAIL_API_KEY=
EMAIL_FROM="Dragonz Central <no-reply@example.com>"
# SMTP (when EMAIL_PROVIDER=smtp). Brevo: smtp-relay.brevo.com, port 587, login + SMTP key from Brevo → SMTP & API
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── Streaming integrations (YouTube + Kick) ──
# mock = show demo data, no API calls (development only; refused in production)
# live = fetch real live status + videos from YouTube and Kick using the keys below
STREAMING_MODE=mock
# How often to check for live streams, in seconds (min 60). YouTube is additionally paced to fit its daily quota.
SYNC_INTERVAL_SECONDS=180

# YouTube Data API v3 key — Google Cloud Console → APIs & Services → Credentials → API key
# (restrict it to "YouTube Data API v3"). Public data only; no OAuth needed.
YOUTUBE_API_KEY=
# Your project's daily YouTube quota (10000 by default)
YOUTUBE_DAILY_QUOTA=10000
# YouTube OAuth (only for creator-authorised membership sync, later phase)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# Kick Dev API app — kick.com → Settings → Developer → Create app (client credentials)
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=

# Twitch (not used yet — provider slot ready)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_EVENTSUB_SECRET=

# ── Media uploads (avatars, banners, news/event images, community posts) ──
# local = save to STORAGE_LOCAL_DIR and serve at /media (dev, or hosts with a persistent disk)
# s3    = any S3-compatible bucket — REQUIRED on Render free (its disk is wiped on every restart)
#   Supabase Storage: S3_ENDPOINT=https://<project>.supabase.co/storage/v1/s3, S3_REGION=<project region>,
#                     MEDIA_PUBLIC_URL=https://<project>.supabase.co/storage/v1/object/public/<bucket>
#   Cloudflare R2:    S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com, S3_REGION=auto,
#                     MEDIA_PUBLIC_URL=https://pub-xxxx.r2.dev (or your custom domain)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./uploads
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public base URL the bucket's files are readable from (s3 only)
MEDIA_PUBLIC_URL=

# ── Scheduled jobs ──
# Secret for GET /api/cron/tick. An external scheduler (cron-job.org) calls it every few minutes so live
# checks, emails and reminders keep running on hosts that sleep. 24+ random chars; empty = endpoint off.
CRON_SECRET=

# ── Seed ──
# Initial SUPER_ADMIN. Dev: `npm run db:seed` (also adds demo data).
# Production: created automatically on start by scripts/create-admin.js (no demo data; min 12 chars).
# Remove SEED_ADMIN_PASSWORD from your host once you've logged in.
SEED_ADMIN_EMAIL=admin@dragonz.local
SEED_ADMIN_PASSWORD=
