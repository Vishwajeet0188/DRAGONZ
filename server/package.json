{
  "name": "@dragonz/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch --env-file=.env src/server.js",
    "start": "node src/server.js",
    "test": "node --env-file=.env.test scripts/migrate.js && node --env-file=.env.test --test --test-concurrency=1 test/*.test.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file=.env scripts/migrate.js",
    "db:seed": "node --env-file=.env scripts/seed.js",
    "db:studio": "drizzle-kit studio",
    "demo:clear": "node --env-file=.env scripts/clear-demo.js",
    "sync:once": "node --env-file=.env scripts/sync-once.js",
    "start:prod": "node scripts/migrate.js && node scripts/create-admin.js && node src/server.js",
    "admin:create": "node --env-file=.env scripts/create-admin.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1141.0",
    "argon2": "^0.45.1",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "^0.45.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.11",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "sharp": "^0.35.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.3.0"
  }
}
